# Copy this file to `.env` and fill in your real values.

PORT=3002

# MongoDB Atlas connection string. Replace <username> and <password>.
# If your password contains special characters (like $), URL-encode them:
#   $ -> %24    @ -> %40    : -> %3A
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.w5pz6vk.mongodb.net/marketflow?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
